# ==========================================
# Vevada Environment Variables Template
# ==========================================
# INSTRUCTIONS: 
# 1. Copy this file and rename it to '.env'
# 2. Replace the placeholder values with your actual secure credentials
# 3. NEVER commit your actual '.env' file to version control!

# --- Database Configuration ---
# The password for the PostgreSQL database user
DB_PASSWORD=your_secure_database_password_here

# The full connection string used by the .NET API
# Note: 'Host=vevada-db' refers to the docker container name inside the Docker network.
DB_CONNECTION_STRING=Host=vevada-db;Database=Vevada;Username=postgres;Password=your_secure_database_password_here

# --- JWT Authentication Settings ---
# Must be a long, cryptographically secure random string (at least 256 bits)
JWT_KEY=your_very_long_and_secure_jwt_secret_key_here
JWT_ISSUER=Vevada
JWT_AUDIENCE=Vevada
JWT_EXPIRE_MINUTES=15

# --- Security & CORS ---
# Comma-separated list of allowed origins (e.g., http://localhost:4200 for local dev)
CORS_ORIGINS=http://localhost:4200

# --- Application Behavior ---
# Set to 'true' to run Entity Framework migrations and seeders on container startup.
RUN_MIGRATIONS_ON_STARTUP=true
